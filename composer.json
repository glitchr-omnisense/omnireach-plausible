{
    "name": "omnireach/plausible",
    "type": "library",
    "description": "Omnireach's Plausible, under any PHP host: visitors, visits, pageviews, bounce rate and visit duration of a site, by page, entry page, source, country, device or day, through Plausible's Stats API v2 (plausible.io or a self-hosted Community Edition).",
    "keywords": [
        "plausible",
        "analytics",
        "audience",
        "stats-api",
        "privacy",
        "framework-agnostic",
        "omnireach"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnireach-plausible",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnireach": "^1.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Omnireach\\Plausible\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnireach\\Plausible\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
